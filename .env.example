NODE_ENV=development
PORT=3000

# Postgres (docker compose shu qiymatlardan foydalanadi)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespw
POSTGRES_DB=financetracker
POSTGRES_PORT=5432

# Lokal (docker'siz) ishga tushirish uchun. Docker ichida compose buni avtomatik "db" hostiga almashtiradi.
DATABASE_URL="postgresql://postgres:postgrespw@localhost:5432/financetracker?schema=public"

# Swagger (/docs). Berilmasa: production'da o'chiq, dev'da yoqiq
# SWAGGER_ENABLED=true

# JWT. Secret yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

NODE_ENV=development
PORT=3000

# Postgres (docker compose shu qiymatlardan foydalanadi)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uniqr
POSTGRES_PORT=5432

# Lokal (docker'siz) ishga tushirish uchun. Docker ichida compose buni avtomatik "db" hostiga almashtiradi.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uniqr?schema=public"

# Swagger (/docs). Berilmasa: production'da o'chiq, dev'da yoqiq
# SWAGGER_ENABLED=true
